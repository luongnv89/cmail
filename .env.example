# Copy to .env — `s-mail setup` fills these in interactively.
# .env is git-ignored; keep it chmod 600.

# Domain for your custom email (e.g. example.com). Leave empty to pick
# from your GoDaddy account during setup.
DOMAIN=

# Gmail address that will receive (and later send as) the custom email.
DEST_EMAIL=

# Comma-separated addresses to create: hello,contact,me -> hello@DOMAIN etc.
ADDRESSES=hello

# Cloudflare API token. Created interactively during setup:
#   https://dash.cloudflare.com/profile/api-tokens
# Permissions: Zone:Edit, DNS:Edit, Email Routing Rules:Edit
#   (Zone Resources: Include -> All zones from an account -> your account)
CLOUDFLARE_API_TOKEN=

# GoDaddy environment (prod or ote). Prod = real account.
GDDY_ENV=prod

# Optional: GoDaddy PAT for non-interactive/headless use instead of
# browser OAuth. Create at https://developer.godaddy.com/personal-access-token
GDDY_PAT=
