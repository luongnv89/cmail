# Copy to .env — `cmail setup` fills these in interactively.
# .env is git-ignored; keep it chmod 600.

# Domain for your custom email (e.g. example.com), registered at any
# registrar. Leave empty to be asked during setup.
DOMAIN=

# Any email address you own that will receive the forwarded mail (Gmail,
# Outlook, iCloud, Proton, ...). Only the optional `cmail send-as` guide
# needs this to be a Gmail/Google account.
DEST_EMAIL=

# Comma-separated addresses to create: hello,contact,me -> hello@DOMAIN etc.
ADDRESSES=hello

# Cloudflare API token. Created interactively during setup:
#   https://dash.cloudflare.com/profile/api-tokens
# Zone permissions: Zone:Edit, Zone Settings:Edit, DNS:Edit, Email Routing Rules:Edit
#   (Zone Resources: Include -> All zones from an account -> your account)
# Account permission: Email Routing Addresses:Edit
#   (Account Resources: Include -> the account that owns your domain)
CLOUDFLARE_API_TOKEN=

# Registrar handling: manual (default) or godaddy.
#   manual  - any registrar; setup prints the Cloudflare nameservers and you
#             update them at your registrar. No gddy or GoDaddy login needed.
#   godaddy - opt-in automation through the gddy CLI: pick/register a GoDaddy
#             domain and apply the nameserver change after confirmation.
REGISTRAR=manual

# GoDaddy settings below are used only when REGISTRAR=godaddy.
# GoDaddy environment (prod or ote). Prod = real account.
GDDY_ENV=prod

# Optional: GoDaddy PAT for non-interactive/headless use instead of
# browser OAuth. Create at https://developer.godaddy.com/personal-access-token
GDDY_PAT=

# Populated automatically by `cmail setup` — the Cloudflare zone ID for
# DOMAIN, reused by `cmail status`. No need to set by hand.
CF_ZONE_ID=

# Optional: 32-character Account ID from the Cloudflare dashboard (NOT Zone ID).
# Set if account discovery returns no accounts or more than one account.
# Skips discovery for zone creation only; token still needs access to the
# selected account/zones. After changing a token, rerun ./cmail setup.
CF_ACCOUNT_ID=

# Optional: set to 1 for a read-only setup preview (same as
# ./cmail setup --dry-run). Can also be passed inline: DRY_RUN=1 ./cmail setup
#DRY_RUN=0
