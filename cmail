#!/usr/bin/env bash
# cmail — guided free custom-domain email setup (Cloudflare Email Routing + Gmail)
# Subcommands: setup | status | doctor | help
set -euo pipefail

CMAIL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for f in ui env deps godaddy cloudflare gmail; do
  . "$CMAIL_DIR/lib/$f.sh"
done

usage() {
  cat <<EOF
cmail — free custom-domain email via Cloudflare Email Routing + Gmail

  ./cmail setup     guided, idempotent setup (auth via browser OAuth)
  ./cmail status    show zone / routing / destination / rules state
  ./cmail doctor    verify tools and credentials, change nothing
  ./cmail help      this message

Config lives in .env (created on first run from .env.example).
DRY_RUN=1 previews the destructive nameserver change.
EOF
}

cmd_setup() {
  CMAIL_STEP="Configuration file"
  CMAIL_DNS_CHECKPOINT=0
  trap 'if [ "$?" -ne 0 ]; then setup_recovery; fi' EXIT
  ensure_deps
  step "Configuration"
  env_init

  # what we're building — collect early so all prompts happen up front
  env_require_prompt DEST_EMAIL "Gmail address to receive forwarded mail"
  env_require_prompt ADDRESSES  "addresses to create, comma-separated (e.g. hello,contact,me)"

  gddy_ensure_auth          # browser OAuth — step shown, URL opened
  gddy_pick_domain          # pick or register; saved to .env
  cf_ensure_token           # opens token page, verifies pasted token

  cf_zone_ensure            # create/reuse CF zone, fetch assigned nameservers
  local zone_id="$CF_ZONE_ID"
  env_set CF_ZONE_ID "$zone_id"

  CMAIL_DNS_CHECKPOINT=1
  gddy_set_nameservers "${CF_NS[@]}"
  cf_zone_wait_active "$zone_id"
  cf_email_enable "$zone_id"
  cf_dest_ensure "$zone_id"
  cf_rules_ensure "$zone_id"
  gmail_sendas_guide
}

cmd_status() {
  env_init
  [ -n "${CLOUDFLARE_API_TOKEN:-}" ] || die "no token in .env — run ./cmail setup"
  local zone_id="${CF_ZONE_ID:-}"
  if [ -z "$zone_id" ]; then
    [ -n "${DOMAIN:-}" ] || die "no DOMAIN in .env — run ./cmail setup"
    local resp
    resp=$(cf_routing_request GET "/zones?name=$DOMAIN") || return 1
    zone_id=$(jq -r '.result[0].id // empty' <<<"$resp")
    [ -n "$zone_id" ] || die "zone for $DOMAIN not found — check token Zone Resources at https://dash.cloudflare.com/profile/api-tokens, then run ./cmail setup"
  fi
  cf_status "$zone_id"
}

cmd_doctor() {
  ensure_deps
  env_init
  step "Auth status"
  gddy auth status 2>/dev/null | jq -r '.data[]? | "gddy \(.env): expired=\(.expired)"' || warn "gddy auth status unavailable"
  if cf_token_valid; then ok "Cloudflare token valid"; else warn "Cloudflare token missing/invalid"; fi
  step "Current .env"
  grep -vE 'TOKEN|PAT|SECRET' "$ENV_FILE" | grep -v '^\s*$' || true
  note "(secret values hidden)"
}

case "${1:-help}" in
  setup)   cmd_setup ;;
  status)  cmd_status ;;
  doctor)  cmd_doctor ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
