#!/usr/bin/env bash
# cmail — guided free custom-domain email setup (Cloudflare Email Routing,
# optional Gmail "Send mail as")
# Subcommands: setup | send-as | status | doctor | help
set -euo pipefail

CMAIL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for f in ui env deps godaddy cloudflare gmail; do
  . "$CMAIL_DIR/lib/$f.sh"
done

usage() {
  cat <<EOF
cmail — free custom-domain email in a few simple steps (Cloudflare Email Routing)

  ./cmail setup     guided, idempotent receive setup: forward your custom
                    addresses to any inbox you own (auth via browser OAuth)
  ./cmail send-as   optional, only on request: guide for sending FROM your
                    custom address with Gmail "Send mail as" (needs a Google
                    account); not part of setup
  ./cmail status    show zone / routing / destination / rules state
  ./cmail doctor    verify tools and credentials, change nothing
  ./cmail help      this message

Config lives in .env (created on first run from .env.example).
DRY_RUN=1 previews the destructive nameserver change.
EOF
}

cmd_setup() {
  CMAIL_STEP="Configuration file"
  CMAIL_DNS_CHECKPOINT=0
  trap 'if [ "$?" -ne 0 ]; then setup_recovery; fi' EXIT
  log "Setting up RECEIVING: your custom addresses will forward to an inbox you already use."
  note "Sending is optional and not part of this setup (./cmail send-as, only if you want it)."
  ensure_deps
  step "Configuration"
  env_init

  # what we're building — collect early so all prompts happen up front
  env_require_prompt DEST_EMAIL "email address to receive forwarded mail (any provider)"
  env_require_prompt ADDRESSES  "addresses to create, comma-separated (e.g. hello,contact,me)"

  gddy_ensure_auth          # browser OAuth — step shown, URL opened
  gddy_pick_domain          # pick or register; saved to .env
  cf_ensure_token           # opens token page, verifies pasted token

  cf_zone_ensure            # create/reuse CF zone, fetch assigned nameservers
  local zone_id="$CF_ZONE_ID"
  env_set CF_ZONE_ID "$zone_id"

  CMAIL_DNS_CHECKPOINT=1
  gddy_set_nameservers "${CF_NS[@]}"
  cf_zone_wait_active "$zone_id"
  cf_email_enable "$zone_id"
  cf_dest_ensure "$zone_id"
  cf_rules_ensure "$zone_id"
  setup_receive_summary
}

setup_receive_summary() {
  step "Receiving is set up"
  local addr list
  IFS=',' read -ra list <<<"$ADDRESSES"
  for addr in "${list[@]}"; do
    addr="${addr// /}"
    if [ -n "$addr" ]; then ok "$addr@$DOMAIN -> $DEST_EMAIL"; fi
  done
  note "Test it: from a DIFFERENT mailbox (not $DEST_EMAIL), send to ${list[0]// /}@$DOMAIN and"
  note "check that it arrives at $DEST_EMAIL (look in Spam too). This is not verified automatically."
  note "Done. Sending is optional: only if you also want to send FROM your custom address"
  note "with Gmail, run ./cmail send-as"
}

cmd_send_as() {
  env_init
  local key
  for key in DOMAIN DEST_EMAIL ADDRESSES; do
    [ -n "${!key:-}" ] || die "no $key in config — run ./cmail setup first so receiving works; send-as confirmation is delivered through forwarding"
  done
  gmail_sendas_guide
}

cmd_status() {
  env_init
  [ -n "${CLOUDFLARE_API_TOKEN:-}" ] || die "no token in .env — run ./cmail setup"
  local zone_id="${CF_ZONE_ID:-}"
  if [ -z "$zone_id" ]; then
    [ -n "${DOMAIN:-}" ] || die "no DOMAIN in .env — run ./cmail setup"
    local resp
    resp=$(cf_routing_request GET "/zones?name=$DOMAIN") || return 1
    zone_id=$(jq -r '.result[0].id // empty' <<<"$resp")
    [ -n "$zone_id" ] || die "zone for $DOMAIN not found — check token Zone Resources at https://dash.cloudflare.com/profile/api-tokens, then run ./cmail setup"
  fi
  cf_status "$zone_id"
}

cmd_doctor() {
  ensure_deps
  env_init
  step "Auth status"
  gddy auth status 2>/dev/null | jq -r '.data[]? | "gddy \(.env): expired=\(.expired)"' || warn "gddy auth status unavailable"
  if cf_token_valid; then ok "Cloudflare token valid"; else warn "Cloudflare token missing/invalid"; fi
  step "Current .env"
  grep -vE 'TOKEN|PAT|SECRET' "$ENV_FILE" | grep -v '^\s*$' || true
  note "(secret values hidden)"
}

case "${1:-help}" in
  setup)   cmd_setup ;;
  send-as) cmd_send_as ;;
  status)  cmd_status ;;
  doctor)  cmd_doctor ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
