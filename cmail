#!/usr/bin/env bash
# cmail — guided free custom-domain email setup (Cloudflare Email Routing,
# optional Gmail "Send mail as")
# Subcommands: setup | send-as | status | list | forward | doctor | config | help
set -euo pipefail
trap 'exit 130' INT
trap 'exit 143' TERM

CMAIL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/cli.sh
. "$CMAIL_DIR/lib/cli.sh"
cli_parse "$@"
# shellcheck source=lib/ui.sh
. "$CMAIL_DIR/lib/ui.sh"
# shellcheck source=lib/output.sh
. "$CMAIL_DIR/lib/output.sh"
# shellcheck source=lib/env.sh
. "$CMAIL_DIR/lib/env.sh"
# shellcheck source=lib/deps.sh
. "$CMAIL_DIR/lib/deps.sh"
# shellcheck source=lib/godaddy.sh
. "$CMAIL_DIR/lib/godaddy.sh"
# shellcheck source=lib/cloudflare.sh
. "$CMAIL_DIR/lib/cloudflare.sh"
# shellcheck source=lib/gmail.sh
. "$CMAIL_DIR/lib/gmail.sh"
# shellcheck source=lib/plan.sh
. "$CMAIL_DIR/lib/plan.sh"

cmd_setup() {
  CMAIL_SETUP_STARTED=$SECONDS
  CMAIL_STEP="Configuration file"
  CMAIL_DNS_CHECKPOINT=0
  trap 'setup_exit "$?"' EXIT
  if ! config_load; then printf 'cmail: could not load config; correct the selected private configuration.\n' >&2; return 3; fi
  REGISTRAR="${REGISTRAR:-manual}"
  if [ "$CMAIL_DRY_RUN" = 1 ] || [ "${DRY_RUN:-0}" = 1 ]; then cmd_setup_plan; return; fi
  [ "$CMAIL_FORMAT" = text ] || cli_error 'JSON setup output requires --dry-run'
  [ -t 0 ] || cli_error 'setup requires terminal input; run it interactively, or use setup --dry-run in scripts'
  if [ "$REGISTRAR" = godaddy ] && [ "$CMAIL_NO_BROWSER" = 1 ] && [ -z "${GDDY_PAT:-}" ]; then
    config_error '--no-browser setup requires an existing GDDY_PAT to prevent automatic GoDaddy OAuth'; return 3
  fi
  log "Setting up RECEIVING: your custom addresses will forward to an inbox you already use."
  note "Sending is optional and not part of this setup (./cmail send-as, only if you want it)."
  ensure_deps
  step "Configuration"
  env_init
  [ -z "$CLI_DOMAIN" ] || { env_set DOMAIN "$DOMAIN"; env_set CF_ZONE_ID ''; }
  [ -z "$CLI_REGISTRAR" ] || env_set REGISTRAR "$REGISTRAR"
  [ -z "$CLI_DESTINATION" ] || env_set DEST_EMAIL "$DEST_EMAIL"
  [ -z "$CLI_ADDRESSES" ] || env_set ADDRESSES "$ADDRESSES"

  # what we're building — collect early so all prompts happen up front
  env_require_prompt DEST_EMAIL "email address to receive forwarded mail (any provider)"
  env_require_prompt ADDRESSES  "addresses to create, comma-separated (e.g. hello,contact,me)"

  if [ "$REGISTRAR" = godaddy ]; then
    # Opt-in registrar automation; the only path that can offer a domain purchase.
    gddy_ensure_auth        # browser OAuth — step shown, URL opened
    gddy_pick_domain        # pick or register; saved to .env
  else
    # Default: an existing domain at any registrar; no gddy or GoDaddy login.
    env_require_prompt DOMAIN "domain you already own, at any registrar (e.g. example.com)"
  fi
  cf_ensure_token           # opens token page, verifies pasted token

  cf_zone_ensure            # create/reuse CF zone, fetch assigned nameservers
  local zone_id="$CF_ZONE_ID"
  env_set CF_ZONE_ID "$zone_id"

  if [ "$REGISTRAR" = godaddy ]; then
    CMAIL_DNS_CHECKPOINT=1
    gddy_set_nameservers "${CF_NS[@]}"
  else
    CMAIL_DNS_CHECKPOINT=2  # instructions only: cmail never changes delegation here
    cf_manual_delegation "$zone_id"
  fi
  cf_zone_wait_active "$zone_id"
  cf_email_enable "$zone_id"
  cf_dest_ensure "$zone_id"
  cf_rules_ensure "$zone_id"
  setup_receive_summary
}

setup_exit() {
  local code="$1"
  trap - EXIT
  if [ "$code" != 0 ]; then
    setup_recovery
    printf 'Elapsed time: ' >&2; output_elapsed "$((SECONDS - CMAIL_SETUP_STARTED))" >&2; printf '\n' >&2
    case "$code" in 2|3|130|143) ;; *) code=1 ;; esac
  fi
  exit "$code"
}

setup_receive_summary() {
  local addr list=()
  printf '\nReceiving is set up\n'
  IFS=',' read -ra list <<< "$ADDRESSES"
  for addr in "${list[@]}"; do
    addr="${addr// /}"
    [ -z "$addr" ] || printf '  %s@%s -> %s\n' "$addr" "$DOMAIN" "$DEST_EMAIL"
  done
  printf '\nElapsed time: '; output_elapsed "$((SECONDS - CMAIL_SETUP_STARTED))"; printf '\n'
  printf 'Test it: from a DIFFERENT mailbox (not %s), send to %s@%s and check delivery (including Spam).\n' "$DEST_EMAIL" "${list[0]// /}" "$DOMAIN"
  printf 'Delivery is not verified automatically. Sending is optional: ./cmail send-as\n'
}

cmd_send_as() {
  config_load || return 3
  local key
  for key in DOMAIN DEST_EMAIL ADDRESSES; do
    [ -n "${!key:-}" ] || { config_error "no $key in config — run ./cmail setup first so receiving works"; return 3; }
  done
  [ -t 0 ] || cli_error 'send-as requires terminal input; run it interactively to follow the manual guide'
  gmail_sendas_guide
}

cmd_status() {
  ensure_read_tools
  config_load || return 3
  if [ -z "${DOMAIN:-}" ] || [ -z "${CLOUDFLARE_API_TOKEN:-}" ]; then
    config_error 'DOMAIN and CLOUDFLARE_API_TOKEN are required; run cmail setup'; return 3
  fi
  local zone_id data text
  zone_id=$(cf_zone_id_for_domain) || return 1
  data=$(cf_status_data "$zone_id") || return 1
  if [ "$CMAIL_FORMAT" = json ]; then output_envelope status "$data"
  else
    text=$(jq -r '
      def target: if .type == "forward" then
          (if (.value // []) == [] then "forward (no destination)" else .value | join(", ") end)
        elif (.value | type) == "array" then "\(.type) \(.value | join(", "))"
        else .type end;
      def targets: if (.actions // []) == [] then "no action" else [.actions[] | target] | join("; ") end;
      def matched: if any(.matchers[]?; .type == "all") then "catch-all" else .matchers[0].value // "custom matcher" end;
      "Domain:        \(.zone.name)", "Zone:          \(.zone.status)",
      "Email routing: \(.routing.status) (enabled=\(.routing.enabled))", "Destinations:",
      (.destinations[] | "  \(.email)  verified=\(.verified)"), "Rules:",
      (.rules[] | "  \(matched) -> \(targets)  enabled=\(.enabled)")' <<< "$data") || die 'could not format routing state; inspect provider data'
    printf '%s\n' "$text"
  fi
}

cmd_list() {
  ensure_read_tools
  config_load || return 3
  if [ -z "${DOMAIN:-}" ] || [ -z "${CLOUDFLARE_API_TOKEN:-}" ]; then
    config_error 'a domain (DOMAIN or --domain) and CLOUDFLARE_API_TOKEN are required'; return 3
  fi
  local zone_id data text
  zone_id=$(cf_zone_id_for_domain) || return 1
  data=$(cf_list_data "$zone_id") || return 1
  if [ "$CMAIL_FORMAT" = json ]; then output_envelope list "$data"; return; fi
  text=$(jq -r '
    def pad($n): if $n > 0 then " " * $n else "" end;
    def target: if .type == "forward" then
        (if .destinations == [] then "forward (no destination)"
         else [.destinations[] | "\(.email) (\(.state))"] | join(", ") end)
      elif .type == "drop" then "drop"
      elif .type == "worker" then "worker \(.value | join(", "))"
      else "\(.type) \(.value | join(", "))" end;
    def targets: if .actions == [] then "no action" else [.actions[] | target] | join("; ") end;
    def shown: .address // "custom matcher (\(.name))";
    ([.addresses[] | shown | length] | max // 0) as $width
    | "Addresses on \(.domain) (\(.addresses | length)):",
      (if .addresses == [] then "  none" else empty end),
      (.addresses[] | "  \(shown)\(pad($width - (shown | length))) -> \(targets)\(if .enabled then "" else "  [disabled]" end)"),
      "Catch-all (any other address): " + (if .catch_all == null then "not configured"
        else "\(if .catch_all.enabled then "enabled" else "disabled" end) -> \(.catch_all | targets)" end)' <<< "$data") \
    || die 'could not format the address list; inspect provider data with --format json'
  printf '%s\n' "$text"
}

cmd_forward() {
  ensure_read_tools
  config_load || return 3
  if [ -z "${DOMAIN:-}" ] || [ -z "${CLOUDFLARE_API_TOKEN:-}" ]; then
    config_error 'a domain (DOMAIN or --domain) and CLOUDFLARE_API_TOKEN are required; run cmail setup first'; return 3
  fi
  [ -t 0 ] || cli_error 'forward requires terminal input to confirm the change; run it interactively'
  local input="${CLI_ARGS[0]}" new="$CLI_DESTINATION" local_part="${CLI_ARGS[0]}" input_domain address rerun
  local zone_id zone account rules state rule old destinations dest
  if [[ "$input" = *@* ]]; then
    local_part="${input%%@*}"
    input_domain=$(printf '%s' "${input#*@}" | tr '[:upper:]' '[:lower:]')
    [ "$input_domain" = "$DOMAIN" ] || cli_error "$input is not on $DOMAIN; pass --domain for another domain"
  fi
  config_local_valid "$local_part" || cli_error "ADDRESS must be a local part such as hello, or hello@$DOMAIN"
  address="$local_part@$DOMAIN"
  rerun="cmail forward $address --destination $new${CLI_DOMAIN:+ --domain $DOMAIN}"

  zone_id=$(cf_zone_id_for_domain) || return 1
  zone=$(cf_routing_request GET "/zones/$zone_id") || return 1
  account=$(jq -er --arg domain "$DOMAIN" '.result | select(.name == $domain) | .account.id | select(type == "string" and length > 0)' <<<"$zone") \
    || die "zone $zone_id is not $DOMAIN or returned malformed data — nothing was changed; check CF_ZONE_ID in cmail config and the Cloudflare dashboard"
  rules=$(cf_rules_list "$zone_id") || return 1
  # Only one literal "to" rule with a single forward to one destination is edited.
  state=$(jq -c --arg a "$address" '
    ($a | ascii_downcase) as $a
    | [.[] | select(any((.matchers // [])[]; (.value | type == "string") and (.value | ascii_downcase) == $a))] as $m
    | if ($m | length) == 0 then {status:"missing"}
      elif ($m | length) > 1 then {status:"unsupported"}
      else $m[0] as $r
        | if ($r.matchers | length) == 1 and $r.matchers[0].type == "literal" and $r.matchers[0].field == "to"
            and ($r.actions | type == "array" and length == 1) and $r.actions[0].type == "forward"
            and ($r.actions[0].value | type == "array" and length == 1 and (.[0] | type == "string" and length > 0))
            and ($r.source // "api") == "api"
          then {status:"ok", rule:$r, current:$r.actions[0].value[0], enabled:($r.enabled == true)}
          else {status:"unsupported"} end
      end' <<<"$rules") || die 'could not read the forwarding rules — nothing was changed'
  case "$(jq -r '.status' <<<"$state")" in
    missing) die "$address has no forwarding rule on $DOMAIN — nothing was changed. Create it first: add $local_part to ADDRESSES and run cmail setup" ;;
    unsupported) die "$address has more than one rule, a custom matcher, a Worker-managed rule or an action other than one forward, so cmail will not edit it. Change it in Cloudflare > $DOMAIN > Email > Email Routing > Routing rules. Existing rules were not changed" ;;
  esac
  rule=$(jq -c '.rule' <<<"$state")
  old=$(jq -r '.current' <<<"$state")
  if jq -e --arg y "$new" '(.current | ascii_downcase) == ($y | ascii_downcase)' >/dev/null <<<"$state"; then
    printf '%s already forwards to %s; nothing changed.\n' "$address" "$old"
    return 0
  fi

  destinations=$(cf_addresses_list "$account") || return 1
  dest=$(jq -c --arg y "$new" '[.[] | select((.email | ascii_downcase) == ($y | ascii_downcase))][0] // empty' <<<"$destinations")
  if [ -z "$dest" ]; then
    warn "$new is not a Cloudflare destination address yet; Cloudflare forwards only to verified destinations"
    confirm "Register $new and send Cloudflare's verification email to it?" \
      || die "nothing was changed; $address still forwards to $old"
    cf_dest_register "$account" "$new" || return 1
    warn "$new registered — click the Cloudflare verification link in $new's inbox (check Spam), then rerun: $rerun. $address is unchanged and still forwards to $old"
    exit 1
  fi
  if jq -e '.verified == null' >/dev/null <<<"$dest"; then
    die "$new is registered but not verified yet — click the Cloudflare verification link in $new's inbox (check Spam; resend it from Cloudflare > $DOMAIN > Email > Email Routing > Destination addresses), then rerun: $rerun. $address is unchanged and still forwards to $old"
  fi
  new=$(jq -r '.email' <<<"$dest")  # Cloudflare's spelling of the verified destination

  jq -e '.enabled' >/dev/null <<<"$state" \
    || warn "the rule for $address is disabled and stays disabled; enable it in Cloudflare > $DOMAIN > Email > Email Routing > Routing rules"
  printf '%s: %s -> %s\n' "$address" "$old" "$new" >&2
  confirm "Change where $address forwards?" || die "cancelled — nothing was changed; $address still forwards to $old"
  cf_rule_forward_update "$zone_id" "$rule" "$new"
  forward_sync_config "$rules" "$rule" "$address" "$new"
  printf '%s now forwards to %s (was %s)\n' "$address" "$new" "$old"
  printf 'Test it: from a DIFFERENT mailbox (not %s), send to %s and check delivery (including Spam).\n' "$new" "$address"
}

# Keep DEST_EMAIL only while it is the one inbox every configured address uses.
forward_sync_config() { # $1 = rules before the change, $2 = changed rule, $3 = address, $4 = new destination
  local i file_domain='' file_addresses='' file_dest='' result pending
  [ -e "$ENV_FILE" ] || return 0
  config_read || { warn 'could not reread the configuration; DEST_EMAIL was not updated'; return 0; }
  for ((i=0; i<${#CONFIG_KEYS[@]}; i++)); do
    case "${CONFIG_KEYS[i]}" in
      DOMAIN) file_domain=$(printf '%s' "${CONFIG_VALUES[i]}" | tr '[:upper:]' '[:lower:]') ;;
      ADDRESSES) file_addresses="${CONFIG_VALUES[i]}" ;;
      DEST_EMAIL) file_dest="${CONFIG_VALUES[i]}" ;;
    esac
  done
  if [ "$file_domain" != "$DOMAIN" ] || [ -z "$file_addresses" ]; then
    note "configuration not changed: $DOMAIN is not the configured domain with ADDRESSES"; return 0
  fi
  result=$(jq -c --argjson changed "$2" --arg address "$3" --arg dest "$4" --arg d "$DOMAIN" --arg list "$file_addresses" '
    ($changed.id // $changed.tag) as $id
    | map(if (.id // .tag) == $id then .actions = [{type:"forward", value:[$dest]}] else . end) as $rules
    | [$list | split(",")[] | gsub("^ +| +$"; "") | select(length > 0) | "\(.)@\($d)" | ascii_downcase] as $configured
    | {member:any($configured[]; . == ($address | ascii_downcase)),
       pending:([$configured[] | . as $a
         | select([$rules[] | select(any((.matchers // [])[]; (.value | type == "string") and (.value | ascii_downcase) == $a))]
             | (length == 1 and (.[0].actions | type == "array" and length == 1) and .[0].actions[0].type == "forward"
                and ((.[0].actions[0].value // []) | map(ascii_downcase)) == [$dest | ascii_downcase]) | not)]
         | join(", "))}' <<<"$1") || { warn 'could not compare configured addresses; DEST_EMAIL was not updated'; return 0; }
  if ! jq -e '.member' >/dev/null <<<"$result"; then
    note "configuration not changed: $3 is not in ADDRESSES"; return 0
  fi
  pending=$(jq -r '.pending' <<<"$result")
  if [ -n "$pending" ]; then
    warn "DEST_EMAIL in the configuration stays ${file_dest:-unset} because these configured addresses forward elsewhere: $pending. cmail setup checks every address against DEST_EMAIL, so it will report them as conflicting until all addresses forward to one inbox (use cmail forward for each)"
  elif [ "$(printf '%s' "$file_dest" | tr '[:upper:]' '[:lower:]')" != "$(printf '%s' "$4" | tr '[:upper:]' '[:lower:]')" ]; then
    if env_set DEST_EMAIL "$4"; then ok "saved DEST_EMAIL=$4: every configured address now forwards there"
    else warn "could not save DEST_EMAIL=$4; set it with cmail config set DEST_EMAIL $4"; fi
  fi
}

doctor_tool() {
  if type -P "$1" >/dev/null; then output_check "$1" pass "$1 available"
  else output_check "$1" fail "$1 missing" "${2:-Install $1 and check PATH.}"; DOCTOR_FAILED=1; fi
}

cmd_doctor() {
  local tool failed=0 invalid=0
  DOCTOR_FAILED=0
  output_checks_start
  for tool in bash curl jq; do doctor_tool "$tool"; done
  if [ ! -e "$ENV_FILE" ] && [ ! -L "$ENV_FILE" ]; then
    output_check config fail 'configuration missing' 'Run cmail config init.'; invalid=1
  elif config_load && config_ready; then
    output_check config pass 'configuration ready'
  else
    output_check config fail 'configuration incomplete' 'Run cmail config check.'; invalid=1
  fi
  # gddy is required only for opt-in GoDaddy automation (REGISTRAR=godaddy).
  if [ "${REGISTRAR:-manual}" = godaddy ]; then
    doctor_tool gddy 'Install gddy and check PATH, or set REGISTRAR=manual to update nameservers at your registrar yourself.'
  elif [ "$invalid" = 0 ]; then
    output_check registrar pass 'manual registrar mode; gddy not required'
  fi
  failed="$DOCTOR_FAILED"
  if [ "$CMAIL_OFFLINE" = 0 ] && [ "$invalid" = 0 ] && [ "$failed" = 0 ]; then
    if cf_token_valid; then output_check cloudflare pass 'Cloudflare token active'
    else output_check cloudflare fail 'Cloudflare token check failed' 'Check token activity and connectivity.'; failed=1; fi
    if [ "${REGISTRAR:-manual}" != godaddy ]; then :
    elif [ -n "${GDDY_PAT:-}" ]; then
      output_check godaddy skipped 'GoDaddy PAT present; provider access not verified' 'Use setup --dry-run to check domain access.'
    elif gddy auth status --json 2>/dev/null | jq -e --arg e "$GDDY_ENV" 'any(.data[]?; .env==$e and .expired==false)' >/dev/null; then
      output_check godaddy pass 'GoDaddy authentication available'
    else output_check godaddy fail 'GoDaddy authentication unavailable' 'Run gddy auth login for the selected environment.'; failed=1; fi
  fi
  output_checks doctor
  [ "$invalid" = 0 ] || return 3
  [ "$failed" = 0 ] || return 1
}

case "$CLI_COMMAND" in
  setup) cmd_setup ;;
  send-as) cmd_send_as ;;
  status) cmd_status ;;
  list) cmd_list ;;
  forward) cmd_forward ;;
  doctor) cmd_doctor ;;
  config) cmd_config ;;
  completion) cat "$CMAIL_DIR/completions/cmail.${CLI_ARGS[0]}" ;;
esac
